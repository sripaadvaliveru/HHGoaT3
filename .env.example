# SerpApi (https://serpapi.com - free tier: 250 searches/month)
SERPAPI_KEY=your_serpapi_key_here

# Sepolia Testnet
# Private key of your test wallet (never use mainnet keys!)
PRIVATE_KEY=your_wallet_private_key_here

# Deployed contract address (fill after deploying FaceVerify.sol)
CONTRACT_ADDRESS=

# Sepolia RPC URL (Alchemy/Infura free tier works)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key_here
